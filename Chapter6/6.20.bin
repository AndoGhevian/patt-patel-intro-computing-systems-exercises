1001 010 000  111111 ; R2 <- Not(R0)
0001 010 010 1 00001 ; R2 <- R2 + 1
0000 111   000000001 ; BRnzp End If
; 1 AlreadyNegative
0001 010 000 1 00000 ; R2 <- R0
; End If

; 2 R3 <- -|R1|
0001 001 001 1 00000 ; R1 <- R1
0000 100   000000011 ; BRn AlreadyNegative
; 3 MakeNegative
1001 011 001  111111 ; R3 <- Not(R1)
0001 011 011 1 00001 ; R3 <- R3 + 1
0000 111   000000001 ; BRnzp End If
; 1 AlreadyNegative
0001 011 001 1 00000 ; R3 <- R1
; End If

; 1 R5 <- zeroed quotient
0101 101 101 1 00000 ; R5 <- 0

; 4 Test R2 - R3 Outer Loop Test
1001 100 011  111111 ; R4 <- Not(R3)
0001 100 100 1 00001 ; R4 <- R4 + 1
0001 100 010 0 00100 ; R4 <- R2 + R4
0000 001   000011101 ; BRp Finilize
; 3 R6 <- 1
0101 110 110 1 00000 ; R6 <- 0
0001 110 110 1 00001 ; R6 <- R6 + 1

0001 100 011 1 00000 ; R4 <- R3

; 10 Test R2 - (SHL R3 1) Inner Loop Test
0001 011 011 0 00011 ; R3 <- R3 + R3 (SHL R3 1)
1001 011 011  111111 ; R3 <- Not(R3)
0001 011 011 1 00001 ; R3 <- R3 + 1
0001 010 010 0 00011 ; R2 <- R2 + R3
0001 011 011 1 11111 ; R3 <- R3 - 1
1001 011 011  111111 ; R3 <- Not(R3)
0001 011 011 1 00000 ; R3 <- R3
0000 001   000000111 ; BRp End Inner Loop
0001 010 010 1 00000 ; R2 <- R2
0000 001   000000100 ; BRp End Inner Loop Reset R2

0001 110 110 0 00110 ; R6 <- R6 + R6
0001 100 011 1 00000 ; R4 <- R3

; Reset R2
0001 010 010 0 00011 ; R2 <- R2 + R3

; Remove 5 instructions "Fill Up Here"

0000 111   111110010 ; BRnzp Inner Loop Test
; 1 End Inner Loop Reset R2
0001 010 010 0 00011 ; R2 <- R2 + R3
; End Inner Loop

0001 101 101 0 00110 ; R5 <- R5 + R6 quotient
; 3 subtract dividable part from R2
1001 100 100  111111 ; R4 <- Not(R4)
0001 100 100 1 00001 ; R4 <- R4 + 1
0001 010 010 0 00100 ; R2 <- R2 + R4

; 2 Reset R3 <- -|R1|
0001 001 001 1 00000 ; R1 <- R1
0000 001   000000010 ; BRp MakeNegative
; 2 AlreadyNegative
0001 011 001 1 00000 ; R3 <- R1
0000 111   000000010 ; BRnzp End If
; 2 MakeNegative
1001 011 001  111111 ; R3 <- Not(R1)
0001 011 011 1 00001 ; R3 <- R3 + 1
; 1 End If

0000 111   111011111 ; BRnzp Outer Loop Test

; Finilize
; 3 Correct Remainder Sign
0001 000 000 1 00000 ; R0 <- R0
0000 001   000000001 ; BRp MakePositiveRemainder
0000 111   000000010 ; BRnzp End If
; 2 MakePositiveRemainder
1001 010 010  111111 ; R2 <- Not(R2)
0001 010 010 1 00001 ; R2 <- R2 + 1
; End If

; 2 Correct Quotient Sign
0001 000 000 1 00000 ; R0 <- R0
0000 001   000000011 ; BRp CaseR0>0
; 3 CaseR0<=0
0001 001 001 1 00000 ; R1 <- R1
0000 100   000000100 ; BRn NotChangeSign
0000 111   000000100 ; BRnzp ChangeSign
; 3 CaseR0>0
0001 001 001 1 00000 ; R1 <- R1
0000 001   000000001 ; BRp NotChangeSign
0000 111   000000001 ; BRnzp ChangeSign
; 1 NotChangeSign
0000 111   000000010 ; BRnzp End Finilize
; 2 ChangeSign
1001 101 101  111111 ; R5 <- Not(R5)
0001 101 101 1 00001 ; R5 <- R5 + 1
; 5 End Finilize

0001 000 101 1 00000 ; R0 <- R5
0001 001 010 1 00000 ; R1 <- R2
1011 000   000000100 ; Mem[5000] <- R0
1011 001   000000100 ; Mem[5001] <- R1
1111 0000   00100101 ; HALT R0=quotient, R1=remainder                                       HALT
; 4
0100 0000 0000 0000 ; X dividend address
0100 0000 0000 0001 ; Y divisor address
0101 0000 0000 0000 ; quotient
0101 0000 0000 0001 ; remainder
