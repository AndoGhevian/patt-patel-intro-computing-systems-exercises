; 3
0011 0000 0000 0000 ; start x3000
0101 000 000 1 00000
1010 000   010001111 ; R0 <- Mem[4000] dividend
1010 001   010001111 ; R1 <- Mem[4001] divisor

; 3 Check divison by zero
0001 001 001 1 00000 ; R1 <- R1
0000 010   000000001 ; BRz DivByZero
0000 111   000101011 ; BRnzp EndDivByZero

; 3 DivByZero
0001 000 000 1 00000 ; R0 <- R0
0000 010   000011100 ; BRz DivZeroByZero
0000 100   000001110 ; BRn DivNegativeByZero

; 4 DivPositiveByZero = +Infinity
0101 000 000 1 00000 ; R0 <- 0
0001 000 000 1 00001 ; R0 <- 1
0101 100 100 1 00000 ; R4 <- 0
0001 100 100 1 01111 ; R4 <- 15
; 5 Shift Loop Test (SHL R0 15)
0001 100 100 1 00000 ; R4 <- R4
0000 010   000000011 ; BRz End Shift Loop
0001 000 000 0 00000 ; R0 <- R0 + R0
0001 100 100 1 11111 ; R4 <- R4 - 1
0000 111   111111011 ; BRnzp Shift Loop Test
; End Shift Loop

; 5 R0 <- +Infinity
1001 000 000  111111 ; R0 <- Not(R0)
0101 001 001 1 00000 ; R1 <- 0
1011 000   001111110 ; Mem[5000] <- R0 quotient
1011 001   001111110 ; Mem[5001] <- R1 remainder
1111 0000   00100101 ; HALT R0=+Infinity R1=0                                          HALT

; 4 DivNegativeByZero = -Infinity
0101 000 000 1 00000 ; R0 <- 0
0001 000 000 1 00001 ; R0 <- 1
0101 100 100 1 00000 ; R4 <- 0
0001 100 100 1 01111 ; R4 <- 15
; 5 Shift Loop Test (SHL R0 15)
0001 100 100 1 00000 ; R4 <- R4
0000 010   000000011 ; BRz End Shift Loop
0001 000 000 0 00000 ; R0 <- R0 + R0
0001 100 100 1 11111 ; R4 <- R4 - 1
0000 111   111111011 ; BRnzp Shift Loop Test
; End Shift Loop

; 4
0101 001 001 1 00000 ; R1 <- 0
1011 000   001110001 ; Mem[5000] <- R0 quotient
1011 001   001110001 ; Mem[5001] <- R1 remainder
1111 0000   00100101 ; HALT R0=-Infinity R1=0                                           HALT

; 4 DivZeroByZero = [-Infinity, +Infinity] (which is undefined)
0101 000 000 1 00000 ; R0 <- 0
0001 000 000 1 00001 ; R0 <- 1
0101 100 100 1 00000 ; R4 <- 0
0001 100 100 1 01111 ; R4 <- 15
; 5 Shift Loop Test (SHL R0 15)
0001 100 100 1 00000 ; R4 <- R4
0000 010   000000011 ; BRz End Shift Loop
0001 000 000 0 00000 ; R0 <- R0 + R0
0001 100 100 1 11111 ; R4 <- R4 - 1
0000 111   111111011 ; BRnzp Shift Loop Test
; End Shift Loop

; 4 R1 <- +Infinity
1001 001 000  111111 ; R1 <- Not(R0)

1011 000   001100100 ; Mem[5000] <- R0
1011 001   001100100 ; Mem[5001] <- R1
1111 0000  00100101 ; HALT [R0, R1] = [-Infinity, +Infinity]                                HALT
; EndDivByZero

; other nich cases

; Case -MAX/-1
; 4 Test R0=-MAX
0001 000 000 1 00000 ; R0 <- R0
0000 010   000001000 ; BRz EndCase
0001 100 000 0 00000 ; R4 <- R0 + R0
0000 101   000000110 ; BRnp EndCase
; 2 Test R1=-1
0001 100 001 1 00001 ; R4 <- R1 - (-1)
0000 101   000000100 ; BRnp EndCase
; 4 R0 <- +MAX
1001 000 000  111111 ; R0 <- Not(R0)
1011 000   001011010 ; Mem[5000] <- R0
1011 001   001011010 ; Mem[5001] <- R1
1111 0000   00100101 ; HALT R0=+MAX, R1=-1                                                 HALT
; EndCase -MAX/-1

; Case ANY/-MAX (-MAX/-MAX, ?/-MAX)
; 4 Test R1=-MAX
0001 001 001 1 00000 ; R1 <- R1
0000 010   000010001 ; BRz EndCase
0001 100 001 0 00001 ; R4 <- R1 + R1
0000 101   000001111 ; BRnp EndCase
; 4 Test R0=-MAX
0001 000 000 1 00000 ; R0 <- R0
0000 010   000001000 ; BRz ?/-MAX
0001 100 000 0 00000 ; R4 <- R0 + R0
0000 101   000000110 ; BRnp ?/-MAX
; 6 Case -MAX/-MAX
0101 000 000 1 00000 ; R0 <- 0
0001 000 000 1 00001 ; R0 <- 1
0101 001 001 1 00000 ; R1 <- 0
1011 000   001001100 ; Mem[5000] <- R0
1011 001   001001100 ; Mem[5001] <- R1
1111 0000   00100101 ; HALT R0=1, R1=0                                                  HALT
; 5 Case ?/-MAX
0001 001 000 1 00000 ; R1 <- R0
0101 000 000 1 00000 ; R0 <- 0
1011 000   001000111 ; Mem[5000] <- R0
1011 001   001000111 ; Mem[5001] <- R1
1111 0000   00100101 ; HALT R0=0, R1=R0                                                   HALT
; EndCase

; modulo division using negative numbers
; invalid implementation, need fix

; 2 R2 < -|R0|
0001 000 000 1 00000 ; R0 <- R0
0000 100   000000011 ; BRn AlreadyNegative
