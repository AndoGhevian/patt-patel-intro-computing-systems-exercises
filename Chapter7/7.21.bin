; Symbol table
; LOOP -> x3004
; NEXT -> x3008
; MASK -> x300D
; PTR1 -> x300E
; PTR2 -> x300F
0011 0000 0000 0000  ; .ORIG x3000
0101 000 000 1 00000 ; R0 <- 0
0001 010 000 1 01010 ; R2 <- R0 + 10
0010 001   000001010 ; R1 <- Mem[MASK]
0010 011   000001010 ; R3 <- Mem[PTR1]
0110 100 011  000000 ; LOOP R4 <- Mem[R3]
0101 100 100 0 00001 ; R4 <- AND(R4, R1)
0000 010   000000001 ; BRz NEXT
0001 000 000 1 00001 ; R0 <- R0 + 1
0001 011 011 1 00001 ; NEXT R3 <- R3 + 1
0001 010 010 1 11111 ; R2 <- R2 - 1
0000 001   111111001 ; BRp LOOP
1011 000   000000011 ; Mem[Mem[PTR2]] <- R0
1111 0000   00100101 ; TRAP x25
1000 0000 0000 0000  ; MASK x8000
0100 0000 0000 0000  ; PTR1 x4000
0101 0000 0000 0000  ; PTR2 x5000

